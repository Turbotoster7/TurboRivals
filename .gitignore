# Full string dump from the binary - large and reproducible with one command
docs/recon/strings_*_all.txt

# Raw captured bytes - generated locally
docs/recon/capture/

# Backups of the hosts file
*.turborivals-*.bak

# The server's private key and stand-in cert - generated locally, not for the repo
proto-lab/pki/

# EA launch variables from a live session - they contain the account JWT and session tokens.
# Only the *.example.txt template with placeholders goes into the repo.
proto-lab/ea_launch_env.txt

__pycache__/
*.pyc

# Rust (phases 3-4)
target/

# Server and Frida logs from test runs - large, generated locally on every test
log-*.txt
frida-*.txt

# launcher: local player nicknames and addresses
launcher/config.json

# PyInstaller, and the virtual environment build.ps1 runs it from
build/
dist/
venv/

# tests/smoke_build.py results (CI)
smoke/

# leftover from the customtkinter version - the UI now lives in launcher/web/
launcher/background.png
